# Copy this file to `.env` and fill in your own Supabase project values.
# Find these in the Supabase dashboard: Project Settings → API.
#
# The anon ("public") key is designed to be shipped in the client — Row-Level
# Security on the database is what protects tenant data. NEVER put the
# service_role key in these VITE_ vars or anywhere in client code.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
